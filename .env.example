# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Endpoint ID for an Ark embedding model, used only by Codify's semantic match
# channel. Leave unset to run on the lexical channels alone: routing and
# detection still work, they just cannot see a rewording. The model has to be
# activated in the Ark console first, or the API answers ModelNotOpen.
# ARK_EMBED_MODEL=ep-replace-with-your-embedding-endpoint-id

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000

# ---------------------------------------------------------------------------
# Codify — learned least-privilege middleware
# ---------------------------------------------------------------------------
# Codify enforces at the container boundary, so it is inert unless
# RUNTIME_PROVIDER=container (which `npm run poc` sets for you). With the
# in-process runner it still redacts, observes and routes, but nothing is
# enforced. /api/system reports both states.
CODIFY_ENABLED=true

# Image used for the per-run broker container. Defaults to the Agent Runtime
# image, which already contains node, so no extra build step is needed.
# CODIFY_BROKER_IMAGE=volc-agent-runtime:local

# Similarity required to treat an inbound prompt as an instance of a governed
# task. Measured, not guessed: rephrasings of one task score 0.45-1.00 and
# unrelated tasks score 0.00-0.05, so 0.65 sits inside that gap.
CODIFY_MATCH_THRESHOLD=0.65

# Codify matches on three channels and routes if ANY of them clears its own
# threshold. They fail in different directions, which is the point: dilution
# defeats the semantic channel while containment holds, and rewording defeats
# both lexical channels while the semantic one holds.
#
# Containment asks what fraction of the governed task is still present in the
# prompt. Unlike similarity it cannot be lowered by saying more, which is what
# closes the padding evasion. Set to 0 to disable the channel.
CODIFY_CONTAINMENT_THRESHOLD=0.6
# Cosine over an Ark embedding. Inert unless ARK_EMBED_MODEL is set.
CODIFY_SEMANTIC_THRESHOLD=0.72
# Master switch for the embedding channel. Defaults on outside tests.
# CODIFY_SEMANTIC=true

# Promotion thresholds. The distinct-user requirement is a control against
# pattern-store poisoning: one user repeating a prompt must never mint a
# contract on their own.
CODIFY_MIN_OCCURRENCES=5
CODIFY_MIN_DISTINCT_USERS=3

# Promote a candidate as soon as it clears its thresholds, with no human in the
# loop. Defensible because promotion does not GRANT capability: the runs it is
# derived from already reached those hosts and wrote those paths, ad hoc and
# unbounded, so the derived scope is a narrowing of what they already had. What
# review actually guards against is laundering one run's behaviour into a
# standing allowance, and that judgement is delegated to a reviewer model which
# sees only the derived facts - hostnames, paths, credential names - never the
# prompts they came from. A person is left with what the reviewer will not sign.
CODIFY_AUTO_PROMOTE=true

# Whether an auto-promoted contract may receive credentials its runs were seen
# using. Off deliberately: a host or a path a task demonstrably used is a
# narrowing of what an ad-hoc run already had, but handing a brand-new principal
# a credential is the one step that genuinely widens reach. A clamped contract
# still runs; it is simply denied, and the denial is the evidence the escalation
# path already requires.
CODIFY_AUTO_GRANT_SECRETS=false

# Mock identity fallback when a request carries no x-codify-user header.
CODIFY_DEFAULT_USER=user-a

# Seed a corpus of observed runs on first boot so the review queue is populated
# at t=0. Only ever applies to a store with no observations of its own.
CODIFY_SEED_FIXTURES=true

# Credentials the platform holds on the Agent's behalf. A Runtime container
# receives one only when the governing contract's scope names it. The value
# never appears in the engine command line, and never in a container whose
# contract does not grant it.
# CODIFY_SECRET_GITHUB_TOKEN=replace-with-a-scoped-token
